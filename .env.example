# --- Database (Cloud SQL for PostgreSQL) used by the running app ---
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
# Only for drizzle-kit (type generation). Never use `drizzle-kit push` on production, see src/db/schema.ts.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# --- Authentication / authorization ---
# Comma-separated Google account emails that are master_admin on first login (bootstrap only).
MASTER_ADMIN_EMAILS=
# Optional: defaults to the projectId in firebase-applet-config.json
FIREBASE_PROJECT_ID=

# --- Scheduled job ---
# Shared secret for Cloud Scheduler calling POST /api/cron once a day (Authorization: Bearer <value>).
CRON_SECRET=

# --- AI Studio (injected automatically) ---
GEMINI_API_KEY=
APP_URL=
